{
  "name": "@obsidian-wechat-agent/wrong-question-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only OpenClaw tool that validates wrong-question input and returns a deterministic write plan.",
  "main": "./dist/extensions/wrong-question-tool/src/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --import tsx --test ../../tests/wrong-question/plugin.test.mjs"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "devDependencies": {
    "openclaw": "2026.7.1-2",
    "typebox": "1.3.3",
    "typescript": "^5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/extensions/wrong-question-tool/src/index.js"
    ],
    "compat": {
      "pluginApi": "2026.7.1",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
