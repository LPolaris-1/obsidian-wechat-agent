{
  // Production-shape fragment. The private production provider also has
  // baseUrl and apiKey fields; their values are omitted.
  models: {
    mode: "merge",
    providers: {
      deepseek: {
        api: "openai-completions",
        auth: "api-key",
        timeoutSeconds: 300,
        models: [{
          id: "deepseek-flash",
          name: "deepseek-flash",
          input: ["text", "image"],
        }],
      },
    },
  },
}
