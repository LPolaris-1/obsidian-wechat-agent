{
  // OpenClaw 2026.7.1-2 shape. Generate a local copy and inject the
  // credential there; never commit a real token or endpoint credential.
  mcp: {
    servers: {
      fns: {
        transport: "streamable-http",
        // The deployed FNS service is reached through a local SSH tunnel.
        // Keep the concrete local port in the ignored runtime config only.
        url: "http://127.0.0.1:19000/api/mcp",
        // Add the scoped MCP credential only in the local runtime config.
        // headers: { Token: "<runtime-injected>" },
        toolFilter: {
          include: ["note_list", "note_get", "note_create_or_update"],
        },
      },
    },
  },
}
