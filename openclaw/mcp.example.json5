{
  // Production-shape fragment. The private production config also has
  // headers.Token; its value is omitted.
  mcp: {
    servers: {
      fns: {
        transport: "streamable-http",
        url: "http://127.0.0.1:9000/api/mcp",
        connectTimeout: 30,
        requestTimeoutMs: 120000,
        toolFilter: {
          include: [
            "file_get_info",
            "file_list",
            "file_read",
            "file_write",
            "note_append",
            "note_create_or_update",
            "note_get",
            "note_get_backlinks",
            "note_get_outlinks",
            "note_list",
            "note_patch_frontmatter",
            "note_prepend",
            "note_replace",
            "vault_list",
          ],
        },
      },
    },
  },
}
